---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import FilterPanel from '../components/FilterPanel.astro';
import { getDatabase } from '../lib/db';
import { getAllGames, getAllCategories, getAllPublishers } from '../lib/games';

export const prerender = true;

const db = getDatabase();
const [games, categories, publishers] = await Promise.all([
  getAllGames(db),
  getAllCategories(db),
  getAllPublishers(db),
]);
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <FilterPanel categories={categories} publishers={publishers} totalCount={games.length} />

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
            {games.map((game) => <GameCard game={game} />)}
          </div>

          <div class="hidden" data-testid="no-results">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  import { parseFilterParam, buildFilterQuery } from '../lib/filters';

  const panel = document.querySelector<HTMLElement>('[data-testid="filter-panel"]');
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="no-results"]');
  const count = document.querySelector<HTMLElement>('[data-testid="filter-result-count"]');
  const clearButton = document.querySelector<HTMLButtonElement>('[data-testid="filter-clear"]');

  if (panel && grid && noResults && count && clearButton) {
    const checkboxes = Array.from(
      panel.querySelectorAll<HTMLInputElement>('input[data-filter-group]'),
    );
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const total = Number(count.dataset.total ?? cards.length);

    const selected = (group: string): string[] =>
      checkboxes
        .filter((box) => box.dataset.filterGroup === group && box.checked)
        .map((box) => box.value);

    // A group with nothing selected is unconstrained; selections are ORed within a group
    // and ANDed across groups.
    const matches = (values: string[], slug: string): boolean =>
      values.length === 0 || values.includes(slug);

    const apply = (updateHistory: boolean): void => {
      const categorySlugs = selected('category');
      const publisherSlugs = selected('publisher');

      let visible = 0;
      for (const card of cards) {
        const isMatch =
          matches(categorySlugs, card.dataset.categorySlug ?? '') &&
          matches(publisherSlugs, card.dataset.publisherSlug ?? '');
        card.classList.toggle('hidden', !isMatch);
        if (isMatch) {
          visible += 1;
        }
      }

      count.textContent = `Showing ${visible} of ${total} games`;
      grid.classList.toggle('hidden', visible === 0);
      noResults.classList.toggle('hidden', visible !== 0);

      if (updateHistory) {
        const query = buildFilterQuery(categorySlugs, publisherSlugs);
        history.replaceState(null, '', `${location.pathname}${query}`);
      }
    };

    const restoreFromUrl = (): void => {
      const params = new URLSearchParams(location.search);
      const wanted: Record<string, string[]> = {
        category: parseFilterParam(params.get('category')),
        publisher: parseFilterParam(params.get('publisher')),
      };
      for (const box of checkboxes) {
        const group = box.dataset.filterGroup ?? '';
        box.checked = wanted[group]?.includes(box.value) ?? false;
      }
    };

    for (const box of checkboxes) {
      box.addEventListener('change', () => apply(true));
    }

    clearButton.addEventListener('click', () => {
      for (const box of checkboxes) {
        box.checked = false;
      }
      apply(true);
    });

    window.addEventListener('popstate', () => {
      restoreFromUrl();
      apply(false);
    });

    restoreFromUrl();
    apply(false);
  }
</script>
