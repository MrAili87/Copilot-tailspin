---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../layouts/Layout.astro';
import GameCard from '../../../components/GameCard.astro';
import PageHero from '../../../components/PageHero.astro';
import EmptyState from '../../../components/EmptyState.astro';
import { getDatabase } from '../../../lib/db';
import { getAllCategories, getGames } from '../../../lib/games';
import { slugify } from '../../../lib/filters';

export const prerender = true;

export const getStaticPaths = (async () => {
  const categories = await getAllCategories(getDatabase());
  const seen = new Set<string>();

  return categories.map((category) => {
    const slug = slugify(category.name);
    // Fail the build rather than silently dropping a route if two names collide.
    if (seen.has(slug)) {
      throw new Error(`Duplicate category slug "${slug}" generated from "${category.name}".`);
    }
    seen.add(slug);

    return { params: { slug }, props: { category } };
  });
}) satisfies GetStaticPaths;

const { category } = Astro.props;
const games = await getGames(getDatabase(), { categoryIds: [category.id] });
---

<Layout title={`${category.name} Games - Tailspin Toys`}>
  <div class="py-8">
    <PageHero title={`${category.name} games`} subtitle={`Games in the ${category.name} category.`}>
      <a
        href="/"
        class="mt-4 inline-block text-blue-400 underline hover:text-blue-300 focus:ring-2 focus:ring-blue-500 focus:outline-none"
        data-testid="back-to-all-games"
      >
        Back to all games
      </a>
    </PageHero>

    {games.length === 0 ? (
      <EmptyState text={`No games in the ${category.name} category yet.`} />
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
        {games.map((game) => <GameCard game={game} />)}
      </div>
    )}
  </div>
</Layout>
